    <!-- About -->
    <string name="about_title">Über TempoTap</string>
    <string name="about_lead">Ein schneller, präziser BPM-Tapper für Musiker, DJs, Tänzer und alle, die antifaschistisch sind.</string>
    <string name="about_features_title">Funktionen</string>
    <string name="about_feature_1">Tap-Tempo mit Ausreißer-Filter und Stabilitätsanzeige</string>
    <string name="about_feature_2">Metronom mit sample-genauem Klick und Akzent</string>
    <string name="about_feature_3">Lokaler Verlauf mit Statistik und Diagramm</string>
    <string name="about_feature_4">Material You, Dark Mode und adaptive Layouts</string>
    <string name="about_privacy_title">Datenschutz</string>
    <string name="about_privacy_body">Alle Messungen und Einstellungen bleiben lokal auf deinem Gerät. Es werden keine Daten übertragen oder Konten benötigt.</string>
    <string name="about_credits">Inspiriert von der Idee von beatsperminuteonline.com. Es werden keine Inhalte oder Marken der Website verwendet.</string>
    <string name="about_made_with">Gebaut mit Kotlin, Jetpack Compose und Material 3.</string>
