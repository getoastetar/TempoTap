    <!-- About -->
    <string name="about_title">About TempoTap</string>
    <string name="about_lead">A fast, precise BPM tapper for musicians, DJs, dancers and anyone who wants to measure a pulse.</string>
    <string name="about_features_title">Features</string>
    <string name="about_feature_1">Tap tempo with outlier filtering and a stability indicator</string>
    <string name="about_feature_2">Metronome with sample-accurate clicks and accents</string>
    <string name="about_feature_3">Local history with statistics and a chart</string>
    <string name="about_feature_4">Material You, dark mode and adaptive layouts</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">All measurements and settings stay on your device. Nothing is uploaded and no account is required.</string>
    <string name="about_credits">Inspired by the idea behind beatsperminuteonline.com. No content or trademarks from that website are used.</string>
    <string name="about_made_with">Built with Kotlin, Jetpack Compose and Material 3.</string>
